# AERO bridge settings for the AirCart drone. Installed by drone/install.sh as
# /etc/aero/bridge.env (mode 0600) and read by aero-bridge.service through
# drone/run_bridge.py. Edit with: sudoedit /etc/aero/bridge.env, then
# sudo systemctl restart aero-bridge.

# From Fleet (https://aero-returns.kv15.workers.dev/fleet) when the drone is
# registered. The key is 64 hex characters and is never printed by the bridge.
AERO_DRONE_ID=
AERO_DRONE_KEY=

# The app. https is required outside loopback (commands are signed, not encrypted).
AERO_SERVER=https://aero-returns.kv15.workers.dev

# Geofence: the HOME PAD entered in Fleet, exactly, and a radius in metres
# (<= 2000). The bridge refuses GOTO targets and takeoffs outside it, in
# addition to the app's own check. Also match the FC's FENCE_RADIUS.
AERO_FENCE_CENTER=37.871900,-122.258500
AERO_FENCE_RADIUS=300

# Altitudes above the home pad, metres. Fleet's "cruise altitude" is what every
# TAKEOFF uses (the demo flies at 10 m); AERO_CRUISE_ALT is only for an RTL that
# has to climb from a remote pad. AERO_MAX_ALT caps every target (hard cap 120).
AERO_CRUISE_ALT=10
AERO_MAX_ALT=60

# Battery % below which the bridge refuses TAKEOFF/GOTO (the app refuses to
# dispatch below 40 %). HOLD/LAND/ABORT are never refused.
AERO_BATTERY_FLOOR=30

# Seconds without a successful exchange with the app before the bridge HOLDs a
# flying drone (and RTLs after twice that). Minimum 5. A 4G hiccup longer
# than this pauses the flight.
AERO_LINK_TIMEOUT=20

# 1 = really arm and fly. Anything else = dry run: the bridge connects, reports
# telemetry and answers every movement command with REJECTED DRY_RUN. Leave
# unset on the bench; set to 1 only on the field with props on and a pilot ready.
AERO_LIVE=

# Flight controller: auto = MAVROS's bridge port tcp:127.0.0.1:5770 when the
# aircart-ros2 service is up, else the ArduPilot USB device directly.
AERO_CONNECT=auto

# Pin the app link to the 4G dongle (NetworkManager connection "lte-dongle")
# so the cellular path is used even while Wi-Fi is up. Empty = default route,
# which in the field is the dongle anyway.
AERO_BIND=nm:lte-dongle

# Optional: AERO_STATE_FILE (replay-protection file, default ~/.aero-bridge-<id>.json),
# AERO_SOURCE_SYSTEM (MAVLink sysid, default 255 = GCS so FS_GCS_ENABLE works),
# AERO_VERBOSE=1, AERO_EXTRA_ARGS="..." (passed to bridge/aero_bridge.py verbatim).
