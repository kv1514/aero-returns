# Copy to .dev.vars for local development; never commit real credentials.
# Drone link (Fleet, /api/drone/*): any random string of 32+ characters, e.g. `openssl rand -base64 32`.
DRONE_LINK_SECRET=
# Optional SMS drone link through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional SpacetimeDB live sync (docs/SPACETIMEDB.md); also needs DRONE_LINK_SECRET. Empty database = off, the app polls as before.
# URI: empty means https://maincloud.spacetimedb.com; http://127.0.0.1:3000 for a local `spacetime start`.
SPACETIMEDB_URI=
SPACETIMEDB_DATABASE=
# The Worker's own identity token from POST <uri>/v1/identity, never the CLI login token.
SPACETIMEDB_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
APIFY_TOKEN=
APIFY_ACTOR_ID=

# Browser-restricted key only; exposed intentionally to the Maps JavaScript SDK.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Login with Amazon profile linking (not order/return API access).
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REDIRECT_URI=http://127.0.0.1:5173/api/amazon/callback

# Supabase Auth (Google, custom:amazon and Email providers configured in Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_GOOGLE_ENABLED=false
SUPABASE_AMAZON_ENABLED=false
# Email + password sign-up/sign-in; set true only after the Email provider is on in Supabase (docs/ACCOUNTS.md).
SUPABASE_EMAIL_ENABLED=false
# Set false only for local HTTP development. Hosted HTTPS defaults to Secure cookies.
SUPABASE_COOKIE_SECURE=false
