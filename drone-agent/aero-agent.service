# systemd unit: sudo cp aero-agent.service /etc/systemd/system/ && sudo systemctl enable --now aero-agent
# Put the token in /etc/aero-agent.env as AERO_DRONE_TOKEN=aero_... (chmod 600), never in this file.
[Unit]
Description=AERO drone agent (website link over 4G)
After=network-online.target ModemManager.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/aero-agent.env
ExecStart=/usr/bin/python3 /opt/aero/aero_agent.py --server ${AERO_SERVER} --token ${AERO_DRONE_TOKEN} --connect /dev/serial0 --baud 921600 --modem /dev/ttyUSB2 --sms-reply --allow-flight
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
